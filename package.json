{
  "name": "medtourney",
  "version": "2.3.0",
  "description": "Mediterranean Chess Tournament Finder",
  "main": "app.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "build:prod": "tsc --sourceMap false",
    "clean": "rm -rf dist",
    "rebuild": "npm run clean && npm run build",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "test:js": "node tests/javascript/test_app.spec.js",
    "test:phase2": "node tests/javascript/test_phase2_features.spec.js",
    "test:calendar": "node tests/unit/test_calendar_export.spec.js",
    "test:unit": "npm run test:calendar && npm run test:phase2",
    "test:python": "python3 -m pytest tests/python -v --override-ini='addopts='",
    "test:integration": "python3 -m pytest tests/integration -v --override-ini='addopts='",
    "test:meta": "python3 -m pytest tests/python/test_scraper_meta.py -v --override-ini='addopts='",
    "test:parity": "python3 -m pytest tests/python/test_frontend_backend_parity.py -v --override-ini='addopts='",
    "test:scraper": "python3 -m pytest tests/integration/test_scraper_optimization.py -v --override-ini='addopts='",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:mobile": "playwright test --project='Mobile Chrome' --project='Mobile Safari'",
    "test:all": "npm run test:js && npm run test:unit && npm run test:python && npm run test:integration && npm run test:e2e",
    "test:v3": "npm run test:phase2 && npm run test:calendar && npm run test:scraper",
    "test": "npm run test:all",
    "pretest": "npm run build",
    "playwright:install": "playwright install --with-deps"
  },
  "keywords": [
    "chess",
    "tournaments",
    "mediterranean",
    "typescript"
  ],
  "author": "MedTourney Project",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.56.1",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "typescript": "^5.3.0"
  }
}
