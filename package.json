{
  "name": "medtourney",
  "version": "2.0.0",
  "description": "Mediterranean Chess Tournament Finder",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "build:prod": "tsc --sourceMap false",
    "clean": "rm -rf dist",
    "rebuild": "npm run clean && npm run build",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "test:js": "node tests/javascript/test_app.spec.js",
    "test:python": "python3 -m pytest tests/python -v --override-ini='addopts='",
    "test:meta": "python3 -m pytest tests/python/test_scraper_meta.py -v --override-ini='addopts='",
    "test:parity": "python3 -m pytest tests/python/test_frontend_backend_parity.py -v --override-ini='addopts='",
    "test:all": "npm run test:js && npm run test:python",
    "test": "npm run test:all",
    "pretest": "npm run build"
  },
  "keywords": [
    "chess",
    "tournaments",
    "mediterranean",
    "typescript"
  ],
  "author": "MedTourney Project",
  "license": "MIT",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "typescript": "^5.3.0"
  }
}
