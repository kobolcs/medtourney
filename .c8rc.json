{
  "all": true,
  "include": [
    "src/**/*.ts",
    "tests/unit/**/*.js",
    "tests/integration/**/*.js"
  ],
  "exclude": [
    "tests/**/*.spec.js",
    "node_modules/**",
    "dist/**",
    "**/*.d.ts",
    "coverage/**",
    ".lighthouseci/**"
  ],
  "reporter": [
    "text",
    "text-summary",
    "html",
    "lcov",
    "json"
  ],
  "report-dir": "./coverage",
  "temp-directory": "./coverage/tmp",
  "clean": true,
  "check-coverage": true,
  "lines": 70,
  "functions": 70,
  "branches": 60,
  "statements": 70
}
