{
  "all": true,
  "include": [
    "dist-test/**/*.js",
    "src/services/CacheManager.ts",
    "src/services/DataService.ts",
    "src/services/ExportService.ts",
    "src/services/FilterService.ts",
    "src/utils/**/*.ts"
  ],
  "exclude": [
    "**/*.d.ts"
  ],
  "reporter": [
    "text",
