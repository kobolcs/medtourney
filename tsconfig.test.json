{
  "//": "Compiles selected production sources to CommonJS so Node-based unit tests can require and exercise the REAL implementation (not duplicated fakes).",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "bundler",
    "outDir": "./dist-test",
    "rootDir": "./src",
    "removeComments": false,
    "sourceMap": true,
    "inlineSources": true,
    "noEmit": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "src/services/CacheManager.ts",
    "src/services/DataService.ts",
    "src/services/ExportService.ts",
    "src/services/FilterService.ts",
    "src/services/UIManager.ts",
    "src/types.ts",
    "src/utils/countrySelection.ts",
    "src/utils/timeControl.ts",
    "src/utils/durationLabel.ts",
    "src/utils/mapPlaces.ts"
  ],
  "exclude": []
}
